{
  "name": "axonmind",
  "version": "0.4.0",
  "private": true,
  "description": "AxonMind - local-first secure knowledge and credential workspace",
  "author": "AxonMind",
  "repository": {
    "type": "git",
    "url": "https://github.com/acid1030/vaultmind.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "NODE_ENV=development electron .",
    "build:ui": "cd ui && npm run build",
    "build": "npm run build:ui && npm run start",
    "package:mac": "npm run build:ui && electron-builder --mac dmg zip",
    "release:mac": "npm run build:ui && electron-builder --mac dmg zip --publish always",
    "test": "node scripts/test-core.js",
    "test:sync": "node scripts/test-sync-multidevice.js",
    "test:package": "node ui/e2e/package-smoke.spec.mjs",
    "test:e2e": "node ui/e2e/auth.spec.mjs && node ui/e2e/content.spec.mjs && node ui/e2e/vault.spec.mjs && node ui/e2e/groups.spec.mjs && node ui/e2e/projects.spec.mjs && node ui/e2e/sync-config.spec.mjs && node ui/e2e/theme-dingtalk.spec.mjs && node ui/e2e/responsive.spec.mjs",
    "test:vector": "node scripts/test-vector.js"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^5.4.296",
    "read-excel-file": "^9.3.10",
    "sql.js": "^1.14.2"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  },
  "build": {
    "appId": "com.axonmind.desktop",
    "productName": "AxonMind",
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "zh-CN",
      "zh-TW"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!assets/app-icon.png",
      "!assets/app-icon.icns",
      "!assets/app-icon.svg",
      "!assets/app-icon-v2.icns",
      "!assets/app-icon-v2.png",
      "!assets/app-icon-axonmind.icns",
      "!node_modules/@napi-rs/canvas*/**",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/legacy/web/**",
      "!node_modules/pdfjs-dist/legacy/build/pdf.sandbox*",
      "!node_modules/pdfjs-dist/legacy/build/*.min.mjs",
      "!node_modules/pdfjs-dist/cmaps/**",
      "!node_modules/pdfjs-dist/iccs/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/legacy/image_decoders/**",
      "!node_modules/pdfjs-dist/standard_fonts/**",
      "!node_modules/pdfjs-dist/wasm/**",
      "!**/*.map",
      "!**/{test,tests,__tests__,example,examples,docs,doc}/**"
    ],
    "mac": {
      "icon": "assets/app-icon-axonmind.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "releaseInfo": {
      "releaseNotesFile": "RELEASE_NOTES.md"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "acid1030",
        "repo": "vaultmind",
        "releaseType": "release"
      }
    ]
  }
}
