{
  "name": "vaultmind",
  "version": "0.3.0",
  "private": true,
  "description": "VaultMind - private knowledge center with secure vault and AI retrieval",
  "author": "VaultMind",
  "repository": {
    "type": "git",
    "url": "https://github.com/acid1030/vaultmind.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "NODE_ENV=development electron .",
    "build:ui": "cd ui && npm run build",
    "build": "npm run build:ui && npm run start",
    "package:mac": "npm run build:ui && electron-builder --mac dmg zip",
    "release:mac": "npm run build:ui && electron-builder --mac dmg zip --publish always",
    "test": "node scripts/test-core.js",
    "test:vector": "node scripts/test-vector.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.vaultmind.desktop",
    "productName": "VaultMind",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/app-icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "releaseInfo": {
      "releaseNotesFile": "RELEASE_NOTES.md"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "acid1030",
        "repo": "vaultmind",
        "releaseType": "release"
      }
    ]
  }
}
